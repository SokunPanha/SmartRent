# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Postgres connection string used by the API route handlers.
# Local dev example (Homebrew Postgres on port 5433 with trust auth):
DATABASE_URL="postgresql://panha@127.0.0.1:5433/rental_db"

# AUTH_SECRET: Secret used by NextAuth (Auth.js v5) to sign session JWTs.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather. Never exposed to the client —
# read only in server-side route handlers (lib/api/telegram.ts).
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# TELEGRAM_BOT_USERNAME: The bot's @username (no @), used to build tenant
# connect deep links (t.me/<username>?start=<code>).
TELEGRAM_BOT_USERNAME="MyRentalBot"

# TELEGRAM_WEBHOOK_SECRET: Shared secret set when registering the webhook
# with Telegram's setWebhook API. Telegram echoes it back on every webhook
# call so /api/telegram/webhook can reject requests that aren't really from
# Telegram. Telegram only allows A-Z, a-z, 0-9, _ and - in this value (a
# base64 secret will be rejected by setWebhook) — generate one with:
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET="generate-with-openssl-rand-hex-32"
