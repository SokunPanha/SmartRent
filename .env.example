# AUTH_SECRET: Shared JWT signing secret. Must be the SAME value the NestJS
# backend uses (see backend/.env.example) — the backend issues the `session`
# cookie, and this app's middleware.ts verifies it directly (no round trip)
# to gate pages. Generate one with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# BACKEND_URL: Where the NestJS backend is running. next.config.ts rewrites
# every /api/* request here, and server components fetch it directly for
# session/permission checks (see lib/auth/server.ts).
BACKEND_URL="http://localhost:4001"
